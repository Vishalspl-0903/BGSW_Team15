{
  "$defs": {
    "CommandRecord": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Ms"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "log_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Log Evidence Id"
        }
      },
      "required": [
        "argv",
        "exit_code",
        "log_evidence_id",
        "duration_ms"
      ],
      "title": "CommandRecord",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAILED",
        "BLOCKED",
        "INCONCLUSIVE"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "$id": "guardian/1.0/ValidationResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after_sbom_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "After Sbom Path"
    },
    "approval_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approval Event Id"
    },
    "before_sbom_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Before Sbom Path"
    },
    "build_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Build Passed"
    },
    "commands": {
      "items": {
        "$ref": "#/$defs/CommandRecord"
      },
      "title": "Commands",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "new_findings": {
      "items": {
        "type": "string"
      },
      "title": "New Findings",
      "type": "array"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "remaining_findings": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Findings",
      "type": "array"
    },
    "removed_findings": {
      "items": {
        "type": "string"
      },
      "title": "Removed Findings",
      "type": "array"
    },
    "rescan_completed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Rescan Completed"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/ValidationStatus"
    },
    "tests_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tests Passed"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "worktree_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Worktree Id"
    }
  },
  "required": [
    "schema_version",
    "scan_id",
    "proposal_id",
    "worktree_id",
    "approval_event_id",
    "status",
    "commands",
    "build_passed",
    "tests_passed",
    "rescan_completed",
    "before_sbom_path",
    "after_sbom_path",
    "removed_findings",
    "new_findings",
    "remaining_findings",
    "warnings",
    "started_at",
    "finished_at"
  ],
  "title": "ValidationResult",
  "type": "object"
}
