{
  "$defs": {
    "RunStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "BLOCKED"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "GIT_PUBLIC",
        "LOCAL_FIXTURE",
        "CACHED_SNAPSHOT"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "StageRecord": {
      "additionalProperties": false,
      "description": "\u00a718.3 explicit per-stage record.  ``null`` means unknown, never zero.",
      "properties": {
        "attempted": {
          "title": "Attempted",
          "type": "boolean"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed At"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "known_matches": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Known Matches"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StageStatus"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool Version"
        }
      },
      "required": [
        "stage",
        "status",
        "attempted",
        "tool",
        "tool_version",
        "reason",
        "completed_at",
        "known_matches",
        "evidence_ids"
      ],
      "title": "StageRecord",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "NOT_RUN",
        "RUNNING",
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "UNAVAILABLE",
        "BLOCKED"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "$id": "guardian/1.0/ScanMetadata.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commit_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Commit Sha"
    },
    "database_snapshots": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Database Snapshots",
      "type": "object"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "repo_url": {
      "title": "Repo Url",
      "type": "string"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "scope_capabilities": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Scope Capabilities",
      "type": "object"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "source_snapshot_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Snapshot Sha256"
    },
    "stage_records": {
      "additionalProperties": {
        "$ref": "#/$defs/StageRecord"
      },
      "title": "Stage Records",
      "type": "object"
    },
    "stage_statuses": {
      "additionalProperties": {
        "$ref": "#/$defs/StageStatus"
      },
      "title": "Stage Statuses",
      "type": "object"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "scan_id",
    "repo_url",
    "commit_sha",
    "source_kind",
    "started_at",
    "finished_at",
    "status",
    "tool_versions",
    "errors",
    "stage_statuses",
    "database_snapshots",
    "source_snapshot_sha256",
    "scope_capabilities"
  ],
  "title": "ScanMetadata",
  "type": "object"
}
