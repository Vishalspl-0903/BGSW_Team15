{
  "$defs": {
    "CoverageSummary": {
      "additionalProperties": false,
      "properties": {
        "declared_only_modules": {
          "minimum": 0,
          "title": "Declared Only Modules",
          "type": "integer"
        },
        "failed_modules": {
          "minimum": 0,
          "title": "Failed Modules",
          "type": "integer"
        },
        "partial_modules": {
          "minimum": 0,
          "title": "Partial Modules",
          "type": "integer"
        },
        "resolved_modules": {
          "minimum": 0,
          "title": "Resolved Modules",
          "type": "integer"
        },
        "total_modules": {
          "minimum": 0,
          "title": "Total Modules",
          "type": "integer"
        },
        "unsupported_modules": {
          "minimum": 0,
          "title": "Unsupported Modules",
          "type": "integer"
        }
      },
      "required": [
        "total_modules",
        "resolved_modules",
        "partial_modules",
        "declared_only_modules",
        "unsupported_modules",
        "failed_modules"
      ],
      "title": "CoverageSummary",
      "type": "object"
    },
    "JsonValue": {},
    "RunStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "BLOCKED"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ScanMetadata": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Commit Sha"
        },
        "database_snapshots": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Database Snapshots",
          "type": "object"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "repo_url": {
          "title": "Repo Url",
          "type": "string"
        },
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "scope_capabilities": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope Capabilities",
          "type": "object"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_snapshot_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Snapshot Sha256"
        },
        "stage_records": {
          "additionalProperties": {
            "$ref": "#/$defs/StageRecord"
          },
          "title": "Stage Records",
          "type": "object"
        },
        "stage_statuses": {
          "additionalProperties": {
            "$ref": "#/$defs/StageStatus"
          },
          "title": "Stage Statuses",
          "type": "object"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "tool_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tool Versions",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "scan_id",
        "repo_url",
        "commit_sha",
        "source_kind",
        "started_at",
        "finished_at",
        "status",
        "tool_versions",
        "errors",
        "stage_statuses",
        "database_snapshots",
        "source_snapshot_sha256",
        "scope_capabilities"
      ],
      "title": "ScanMetadata",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "GIT_PUBLIC",
        "LOCAL_FIXTURE",
        "CACHED_SNAPSHOT"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "StageRecord": {
      "additionalProperties": false,
      "description": "\u00a718.3 explicit per-stage record.  ``null`` means unknown, never zero.",
      "properties": {
        "attempted": {
          "title": "Attempted",
          "type": "boolean"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed At"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "known_matches": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Known Matches"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StageStatus"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool Version"
        }
      },
      "required": [
        "stage",
        "status",
        "attempted",
        "tool",
        "tool_version",
        "reason",
        "completed_at",
        "known_matches",
        "evidence_ids"
      ],
      "title": "StageRecord",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "NOT_RUN",
        "RUNNING",
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "UNAVAILABLE",
        "BLOCKED"
      ],
      "title": "StageStatus",
      "type": "string"
    },
    "ValidationStatus": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAILED",
        "BLOCKED",
        "INCONCLUSIVE"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "$id": "guardian/1.0/Report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifact Paths",
      "type": "object"
    },
    "claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "component_count": {
      "minimum": 0,
      "title": "Component Count",
      "type": "integer"
    },
    "coverage_summary": {
      "$ref": "#/$defs/CoverageSummary"
    },
    "edge_count": {
      "minimum": 0,
      "title": "Edge Count",
      "type": "integer"
    },
    "finding_ids": {
      "items": {
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "findings_summary": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Findings Summary",
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/ScanMetadata"
    },
    "occurrence_count": {
      "minimum": 0,
      "title": "Occurrence Count",
      "type": "integer"
    },
    "proposal_ids": {
      "items": {
        "type": "string"
      },
      "title": "Proposal Ids",
      "type": "array"
    },
    "residual_risks": {
      "items": {
        "type": "string"
      },
      "title": "Residual Risks",
      "type": "array"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "validation_status": {
      "$ref": "#/$defs/ValidationStatus"
    }
  },
  "required": [
    "schema_version",
    "scan_id",
    "metadata",
    "coverage_summary",
    "component_count",
    "occurrence_count",
    "edge_count",
    "findings_summary",
    "finding_ids",
    "claim_ids",
    "proposal_ids",
    "validation_status",
    "residual_risks",
    "limitations",
    "artifact_paths"
  ],
  "title": "Report",
  "type": "object"
}
