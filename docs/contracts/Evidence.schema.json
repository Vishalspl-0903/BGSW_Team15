{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "MANIFEST",
        "LOCKFILE",
        "SBOM",
        "ADVISORY",
        "RULE_MATCH",
        "TOOL_LOG",
        "CI_CONFIG",
        "VALIDATION",
        "MODEL_OUTPUT"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "JsonValue": {}
  },
  "$id": "guardian/1.0/Evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "json_pointer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Json Pointer"
    },
    "kind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "line_end": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Line End"
    },
    "line_start": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Line Start"
    },
    "observation": {
      "title": "Observation",
      "type": "string"
    },
    "observed_value": {
      "$ref": "#/$defs/JsonValue"
    },
    "raw_artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Artifact"
    },
    "raw_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Sha256"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "source_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Path"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "tool_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tool Name"
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tool Version"
    }
  },
  "required": [
    "schema_version",
    "scan_id",
    "evidence_id",
    "kind",
    "tool_name",
    "tool_version",
    "source_path",
    "json_pointer",
    "line_start",
    "line_end",
    "observed_value",
    "raw_artifact",
    "raw_sha256",
    "observation",
    "recorded_at"
  ],
  "title": "Evidence",
  "type": "object"
}
